{
  "name": "reducer-state-machine",
  "version": "0.0.0",
  "description": "A checkout modelled as a state machine with useReducer.",
  "author": "Mike Bild <mike.bild@gmail.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
